{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RimWorld Forge",
  "version": "1.0.4",
  "identifier": "com.rimworld.modhelper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl":"http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "RimWorld Forge",
        "width": 1020,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$USERPROFILE/**", "$APPDATA/**", "$HOME/**", "C:/**", "D:/**", "E:/**", "F:/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {}
  }
}
